# Get the token from @BotFather
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Your Telegram numeric ID(s), comma separated. Send /myid to the bot to find yours.
ADMIN_IDS=

BRAND_NAME=Gecho Car Lottery

# Payment details shown to customers (leave empty to hide a line)
CBE_ACCOUNT=1000XXXXXXXXXXXX Account Holder Name
TELEBIRR_NUMBER=09XXXXXXXX

RESERVATION_MINUTES=30
# Max numbers one person can hold per car (0 = unlimited)
MAX_NUMBERS_PER_USER=0
TZ_OFFSET_HOURS=3

# PostgreSQL connection URL (Neon: copy it from the dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
